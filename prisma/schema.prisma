// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatar        String?
  passwordHash  String?   // null if registered via Google OAuth
  role          String    @default("USER") // USER, MERCHANT, ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  bookmarks         Bookmark[]
  subscriptionTags  UserSubscriptionTag[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String   // "google", "email"
  providerAccountId String   // Google sub ID or email
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  dealId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dealId])
  @@index([userId])
  @@map("bookmarks")
}

model UserSubscriptionTag {
  id        String   @id @default(cuid())
  userId    String
  tagName   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tagName])
  @@index([userId])
  @@map("user_subscription_tags")
}

model Deal {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  category       String
  channelType    String
  merchantName   String
  merchantLogo   String?
  storeBranches  String?
  regions        String[]
  originalPrice  Float?
  discountPrice  Float?
  priceUnit      String?
  targetItems    String[]
  conditions     String[]
  eligibleCards  String[]
  tags           String[]
  startDate      String
  endDate        String
  isHot          Boolean  @default(false)
  isFlashDeal    Boolean  @default(false)
  source         String   @default("official")
  sourcePlatform String?
  sourceUrl      String?
  likeCount      Int      @default(0)
  commentCount   Int      @default(0)
  priceHistory   Json?
  priceDropAlert Json?
  imageUrl       String?
  images         String[]
  aspectRatio    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([channelType])
  @@index([isHot])
  @@index([isFlashDeal])
  @@index([createdAt])
  @@map("deals")
}

model AdCampaign {
  id               String   @id @default(cuid())
  merchantName     String
  merchantLogo     String?
  title            String
  subtitle         String?
  imageUrl         String
  ctaText          String?
  discountBadge    String?
  placement        String   @default("hero_banner")
  biddingModel     String   @default("cpm")
  dailyBudget      Float
  durationDays     Int
  startDate        String
  endDate          String
  totalBudget      Float
  spentBudget      Float    @default(0)
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  ctr              Float    @default(0)
  status           String   @default("active")
  targetCategories String[]
  targetRegions    String[]
  targetTags       String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([merchantName])
  @@index([status])
  @@map("ad_campaigns")
}

model CrawlerLog {
  id            String   @id @default(cuid())
  targetId      String?
  targetName    String
  type          String   // "scheduled", "manual", "auto_purge"
  status        String   // "success", "failed", "running"
  crawledCount  Int      @default(0)
  insertedCount Int      @default(0)
  message       String
  details       Json?
  createdAt     DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("crawler_logs")
}

model CrawlerTarget {
  id                    String    @id
  name                  String
  url                   String
  logo                  String?
  targetType            String    @default("fanpage") // "fanpage", "official_web", "blog_media"
  defaultCategory       String    @default("food")
  enabled               Boolean   @default(true)
  lastCrawledAt         DateTime?
  lastStatus            String    @default("idle") // "idle", "success", "failed", "running"
  crawledCount          Int       @default(0)
  scheduleMode          String    @default("inherit") // "inherit", "custom", "interval"
  customScheduleTimes   String[]
  customIntervalMinutes Int       @default(60)
  crawlRule             String?
  brandGroup            String?   // 所屬品牌/主群組（例如：全家 FamilyMart、7-ELEVEN、家樂福）
  sortOrder             Int       @default(0) // 自訂拖曳顯示排序
  isCustom              Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([enabled])
  @@index([targetType])
  @@index([brandGroup])
  @@index([sortOrder])
  @@map("crawler_targets")
}

model CrawlerSchedule {
  id                    String   @id @default("global")
  enabled               Boolean  @default(true)
  goldenWindows         String[]
  thursdayRushHours     String[]
  nightQuietStart       String   @default("01:00")
  nightQuietEnd         String   @default("07:30")
  customIntervalMinutes Int      @default(60)
  updatedAt             DateTime @updatedAt

  @@map("crawler_schedules")
}

model BrandGroupConfig {
  id        String   @id @default(cuid())
  brandName String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand_group_configs")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
